<Window x:Class="SteamLANControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam LAN Control Center v2.0" Height="720" Width="580"
        Background="#181825" WindowStartupLocation="CenterScreen" ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="🎮 STEAM LAN CONTROL CENTER" FontSize="22" FontWeight="Bold" Foreground="#f5e0dc" HorizontalAlignment="Center"/>
            <TextBlock Text="Gelişmiş Goldberg LAN &amp; Radmin VPN Otomasyon Paneli" FontSize="11" Foreground="#a6adc8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Canlı Durum Kartı -->
        <Border Grid.Row="1" Background="#1e1e2e" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#313244" BorderThickness="1">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <TextBlock x:Name="TxtRadminStatus" Text="🔴 Radmin VPN: Kontrol Ediliyor..." FontSize="13" FontWeight="SemiBold" Foreground="#f38ba8"/>
                    <TextBlock x:Name="TxtPingStatus" Text="Ping: -- ms" FontSize="12" Foreground="#a6adc8" HorizontalAlignment="Right"/>
                </Grid>
                <TextBlock x:Name="TxtPatchStatus" Text="🔴 Oyun Durumu: Klasör Seçilmedi" FontSize="13" FontWeight="SemiBold" Foreground="#f38ba8"/>
            </StackPanel>
        </Border>

        <!-- Ayarlar ve Girdiler -->
        <Border Grid.Row="2" Background="#1e1e2e" CornerRadius="8" Padding="15" Margin="0,0,0,15" BorderBrush="#313244" BorderThickness="1">
            <StackPanel>
                <!-- Oyun Klasör Seçimi -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Oyun Klasörü:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="TxtGamePath" IsReadOnly="True" Background="#11111b" Foreground="#a6adc8" BorderBrush="#45475a" Padding="5" FontSize="11" Grid.Column="1"/>
                    <Button Grid.Column="2" Content="..." Click="BtnBrowse_Click" Background="#45475a" Foreground="#cdd6f4" Margin="5,0,0,0" Cursor="Hand"/>
                </Grid>

                <!-- Oyuncu İsmi & AppID -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="80"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Oyuncu Adı:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="TxtPlayerName" Grid.Column="1" Text="Player1" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="5" FontSize="12" Margin="0,0,10,0"/>

                    <TextBlock Text="AppID:" Grid.Column="2" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="TxtAppId" Grid.Column="3" Text="480" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="5" FontSize="12"/>
                </Grid>

                <!-- Arkadaş Radmin IP & Oyun Dili -->
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="110"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Arkadaş IP:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="12"/>
                    <TextBox x:Name="TxtFriendIp" Grid.Column="1" Text="26.x.x.x" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="5" FontSize="11" Margin="0,0,10,0" TextChanged="TxtFriendIp_TextChanged"/>

                    <TextBlock Text="Dil:" Grid.Column="2" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="12"/>
                    <ComboBox x:Name="CmbLanguage" Grid.Column="3" Background="#11111b" Foreground="#11111b" BorderBrush="#45475a" FontSize="11">
                        <ComboBoxItem Content="english" IsSelected="True"/>
                        <ComboBoxItem Content="turkish"/>
                        <ComboBoxItem Content="german"/>
                        <ComboBoxItem Content="french"/>
                        <ComboBoxItem Content="russian"/>
                    </ComboBox>
                </Grid>

                <!-- Onay Kutuları -->
                <WrapPanel Margin="0,5,0,0">
                    <CheckBox x:Name="ChkUnlockDlc" Content="Tüm DLC'leri Aç" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,15,5"/>
                    <CheckBox x:Name="ChkFirewall" Content="Güvenlik Duvarı İzni" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,15,5"/>
                    <CheckBox x:Name="ChkCustomBroadcast" Content="Radmin Lobi Sabitleme" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,0,5"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- İşlem Butonları -->
        <Grid Grid.Row="3" Margin="0,0,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Button Content="⚡ Goldberg Fix Uygula" Click="BtnApplyFix_Click" Background="#a6e3a1" Foreground="#11111b" FontWeight="Bold" Padding="10" Margin="0,0,5,0" Cursor="Hand"/>
            <Button Content="🔄 Geri Yükle" Click="BtnRestore_Click" Background="#f9e2af" Foreground="#11111b" FontWeight="Bold" Padding="10" Grid.Column="1" Margin="2,0,2,0" Cursor="Hand"/>
            <Button x:Name="BtnLaunch" Content="🚀 Oyunu Başlat" Click="BtnLaunch_Click" IsEnabled="False" Background="#89b4fa" Foreground="#11111b" FontWeight="Bold" Padding="10" Grid.Column="2" Margin="5,0,0,0" Cursor="Hand"/>
        </Grid>

        <!-- Bilgi Konsolu -->
        <TextBox x:Name="TxtLog" Grid.Row="4" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#11111b" Foreground="#a6e3a1" FontFamily="Consolas" FontSize="11" Padding="8" BorderBrush="#313244"/>
    </Grid>
</Window>
