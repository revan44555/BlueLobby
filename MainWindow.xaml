<Window x:Class="SteamLANControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam LAN Control Center v3.0"
        Width="1280" Height="820" MinWidth="980" MinHeight="680"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterScreen"
        Background="#0b1220" Foreground="#e6edf7"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        Loaded="Window_Loaded" Closed="Window_Closed"
        AllowDrop="True" DragEnter="Window_DragEnter" Drop="Window_Drop">
    <Window.Resources>
        <SolidColorBrush x:Key="Bg" Color="#0b1220"/>
        <SolidColorBrush x:Key="Sidebar" Color="#0a101b"/>
        <SolidColorBrush x:Key="Card" Color="#111a2a"/>
        <SolidColorBrush x:Key="Card2" Color="#0d1625"/>
        <SolidColorBrush x:Key="Border" Color="#20314a"/>
        <SolidColorBrush x:Key="Text" Color="#e6edf7"/>
        <SolidColorBrush x:Key="Muted" Color="#8fa2bc"/>
        <SolidColorBrush x:Key="Blue" Color="#3b82f6"/>
        <SolidColorBrush x:Key="Cyan" Color="#22d3ee"/>
        <SolidColorBrush x:Key="Green" Color="#22c55e"/>
        <SolidColorBrush x:Key="Orange" Color="#f59e0b"/>
        <SolidColorBrush x:Key="Red" Color="#ef4444"/>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#a9b7ca"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="13,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#2563eb"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SecondaryButton" TargetType="Button">
            <Setter Property="Background" Value="#17243a"/>
            <Setter Property="Foreground" Value="#d8e2f0"/>
            <Setter Property="BorderBrush" Value="#2a405e"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Card}"/>
            <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style x:Key="InputStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#0a1220"/>
            <Setter Property="Foreground" Value="#dbe7f5"/>
            <Setter Property="BorderBrush" Value="#263b58"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}"/>
            <Setter Property="FontSize" Value="11"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource Bg}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="214"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0" Background="{StaticResource Sidebar}" BorderBrush="#17263b" BorderThickness="0,0,1,0" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="6,5,6,22">
                        <Border Width="34" Height="34" CornerRadius="9" Background="#1769e0">
                            <TextBlock Text="🎮" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="TxtTitle" Text="Steam LAN Control Center" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource Text}"/>
                            <TextBlock x:Name="TxtSubtitle" Text="LAN oyun merkezi" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="TxtWarn" Text="Sahip olduğunuz oyunlar için." FontSize="9" Foreground="#7f91aa" Margin="6,0,6,14"/>

                    <Button x:Name="NavHome" Tag="home" Content="⌂   Ana Sayfa" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavOyun" Tag="game" Content="▣   Oyunlar" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavFriends" Tag="friends" Content="♟   Oyun Odası" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavNetwork" Tag="network" Content="⌁   Ağ" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavTools" Tag="tools" Content="⚒   Araçlar" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavLog" Tag="log" Content="☷   Loglar" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                    <Button x:Name="NavSettings" Tag="settings" Content="⚙   Ayarlar" Click="Nav_Click" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <Border x:Name="MascotCard" DockPanel.Dock="Bottom" Background="#101b2c" BorderBrush="#20314a" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock x:Name="TxtMascot" Text="🤖" FontSize="28" HorizontalAlignment="Center" Cursor="Hand" MouseLeftButtonUp="TxtMascot_Click">
                            <TextBlock.RenderTransform><TranslateTransform x:Name="MascotTransform"/></TextBlock.RenderTransform>
                        </TextBlock>
                        <TextBlock Text="Mavi" FontWeight="SemiBold" Foreground="{StaticResource Text}" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                        <TextBlock Text="Gerçek ağ verileriyle tanı." FontSize="9" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,2,0,0"/>
                    </StackPanel>
                </Border>
            </DockPanel>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1" Margin="22,18,22,18">
            <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Background="#101a2a" BorderBrush="#20314a" BorderThickness="1" CornerRadius="9" Height="38" MaxWidth="520" HorizontalAlignment="Left" Padding="12,0">
                    <Grid>
                        <TextBlock Text="⌕" Foreground="#647a98" FontSize="16" VerticalAlignment="Center"/>
                        <TextBox x:Name="SearchBox" Margin="26,0,0,0" Background="Transparent" BorderThickness="0" Foreground="#b9c8db" VerticalContentAlignment="Center" Text="Oyun ara...  (Ctrl + K)"/>
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="●" Foreground="#22c55e" FontSize="10" Margin="0,0,7,0"/>
                    <TextBlock Text="Radmin bağlı" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,16,0"/>
                    <TextBlock Text="⚙" Foreground="#9fb0c5" FontSize="16"/>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <!-- HOME -->
                    <StackPanel x:Name="SectionHome" Visibility="Visible">
                        <Border Style="{StaticResource CardStyle}" Padding="0" Margin="0,0,0,14">
                            <Grid Height="224">
                                <Border Background="#15243a" CornerRadius="12">
                                    <Grid>
                                        <Rectangle Fill="#15243a" Opacity="0.55"/>
                                        <StackPanel Margin="24" VerticalAlignment="Center">
                                            <TextBlock Text="COUNTER-STRIKE 2" FontSize="27" FontWeight="Bold" Foreground="White"/>
                                            <TextBlock Text="LAN oturumu için hazır" Foreground="#b7c8dc" FontSize="12" Margin="0,5,0,16"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Background="#0b2b21" BorderBrush="#1f8f5f" BorderThickness="1" CornerRadius="15" Padding="10,5" Margin="0,0,7,0"><TextBlock Text="✓ SİSTEM HAZIR" Foreground="#4ade80" FontWeight="SemiBold" FontSize="11"/></Border>
                                                <Border Background="#0e2632" BorderBrush="#1f6577" BorderThickness="1" CornerRadius="15" Padding="10,5"><TextBlock Text="LAN MODU" Foreground="#67e8f9" FontWeight="SemiBold" FontSize="11"/></Border>
                                            </StackPanel>
                                        </StackPanel>
                                        <Button x:Name="BtnLaunch" Content="▶   OYUNU BAŞLAT" Click="BtnLaunch_Click" IsEnabled="False" Style="{StaticResource PrimaryButton}" Width="190" Height="46" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,22"/>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,7,0">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,10"><TextBlock Text="Oyun Odası" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock DockPanel.Dock="Right" Text="Ağdaki oyuncular" Foreground="{StaticResource Muted}" FontSize="10"/></DockPanel>
                                    <StackPanel>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Revan (Sen)  ·  Host" Foreground="#dbe7f5" FontSize="12"/><TextBlock Text="● 18 ms" Grid.Column="1" Foreground="#4ade80" FontSize="11"/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ali" Foreground="#dbe7f5" FontSize="12"/><TextBlock Text="● 21 ms" Grid.Column="1" Foreground="#4ade80" FontSize="11"/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Emre" Foreground="#dbe7f5" FontSize="12"/><TextBlock Text="● 24 ms" Grid.Column="1" Foreground="#4ade80" FontSize="11"/></Grid>
                                        <Grid Margin="0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Deniz" Foreground="#dbe7f5" FontSize="12"/><TextBlock Text="● 82 ms" Grid.Column="1" Foreground="#f59e0b" FontSize="11"/></Grid>
                                    </StackPanel>
                                    <Button Content="Oyun Odasını Aç →" Click="Nav_Click" Tag="friends" Style="{StaticResource SecondaryButton}" Margin="0,12,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="7,0">
                                <StackPanel>
                                    <TextBlock Text="Ağ Durumu" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                                    <TextBlock x:Name="TxtRadminStatus" Text="● Radmin VPN: Bağlı" Foreground="#4ade80" FontSize="12" Margin="0,10,0,0"/>
                                    <Grid Margin="0,13,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Ping" Style="{StaticResource LabelStyle}"/><TextBlock x:Name="TxtPingStatus" Text="18 ms" Foreground="#67e8f9" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="Kayıp" Style="{StaticResource LabelStyle}"/><TextBlock Text="0%" Foreground="#4ade80" FontSize="18" FontWeight="SemiBold"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Jitter" Style="{StaticResource LabelStyle}"/><TextBlock Text="2 ms" Foreground="#dbe7f5" FontSize="18" FontWeight="SemiBold"/></StackPanel></Grid>
                                    <Button Content="Ağ ayrıntıları →" Click="Nav_Click" Tag="network" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Margin="7,0,0,0">
                                <StackPanel>
                                    <DockPanel><TextBlock Text="Mavi" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock DockPanel.Dock="Right" Text="AI" Foreground="#67e8f9" FontSize="10"/></DockPanel>
                                    <TextBlock Text="Sistem normal." Foreground="#b8c8da" FontSize="12" Margin="0,11,0,0" TextWrapping="Wrap"/>
                                    <TextBlock Text="Gerçek bir ağ sorunu oluştuğunda burada neden ve önerilen test görünür." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                    <Button x:Name="BtnMascotHelp" Content="Mavi'yi Aç" MouseLeftButtonUp="TxtMascot_Click" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <DockPanel><StackPanel DockPanel.Dock="Left"><TextBlock Text="Yerel sistem kontrolü" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Bu bilgiler doğrulanabilir yerel durumları gösterir; oyun lobisi hazır olduğu varsayılmaz." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><TextBlock x:Name="TxtPatchStatus" DockPanel.Dock="Right" Text="● Oyun: Klasör seçilmedi" Foreground="#f59e0b" VerticalAlignment="Center" FontSize="11"/></DockPanel>
                        </Border>
                    </StackPanel>

                    <!-- GAMES / CONFIG -->
                    <StackPanel x:Name="SectionGame" Visibility="Collapsed">
                        <TextBlock Text="Oyunlar" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Oyunları seç, kurulum durumunu kontrol et ve LAN başlat." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
                        <WrapPanel Margin="0,0,0,14">
                            <Border Style="{StaticResource CardStyle}" Width="230" Margin="0,0,10,10" Padding="0">
                                <StackPanel>
                                    <Border Height="92" Background="#182c45" CornerRadius="12,12,0,0"><TextBlock Text="COUNTER-STRIKE 2" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                                    <Border Padding="12"><StackPanel><TextBlock Text="CS2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="LAN Destekli · Steam" Foreground="#8fa2bc" FontSize="10" Margin="0,3,0,9"/><Button Content="Seç / Yapılandır" Style="{StaticResource PrimaryButton}" Click="Nav_Click" Tag="game"/></StackPanel></Border>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="230" Margin="0,0,10,10" Padding="0">
                                <StackPanel><Border Height="92" Background="#243b2b" CornerRadius="12,12,0,0"><TextBlock Text="LEFT 4 DEAD 2" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Padding="12"><StackPanel><TextBlock Text="Left 4 Dead 2" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="LAN Destekli · Steam" Foreground="#8fa2bc" FontSize="10" Margin="0,3,0,9"/><Button Content="Kurulum seç" Style="{StaticResource SecondaryButton}"/></StackPanel></Border></StackPanel>
                            </Border>
                            <Border Style="{StaticResource CardStyle}" Width="230" Margin="0,0,10,10" Padding="0">
                                <StackPanel><Border Height="92" Background="#2d2450" CornerRadius="12,12,0,0"><TextBlock Text="TERRARIA" FontSize="15" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border Padding="12"><StackPanel><TextBlock Text="Terraria" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="LAN Destekli · Steam" Foreground="#8fa2bc" FontSize="10" Margin="0,3,0,9"/><Button Content="Kurulum seç" Style="{StaticResource SecondaryButton}"/></StackPanel></Border></StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource CardStyle}" Margin="0,0,0,14">
                            <DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Seçili oyun: Counter-Strike 2" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Yapılandırma ve güvenli başlatma" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,3,0,0"/></StackPanel><Button x:Name="BtnFindEmulator" Content="Emülatörü Ara" Click="BtnFindEmulator_Click" Style="{StaticResource SecondaryButton}" DockPanel.Dock="Right"/></DockPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0"><TextBlock Text="Oyun klasörü" Style="{StaticResource LabelStyle}"/><Grid Margin="0,5,0,12"><TextBox x:Name="TxtGamePath" Style="{StaticResource InputStyle}"/><Button x:Name="BtnBrowse" Content="…" Click="BtnBrowse_Click" Width="34" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}"/></Grid><TextBlock Text="Çalıştırıcı" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="CmbExes" Background="#0a1220" Foreground="#dbe7f5" BorderBrush="#263b58" Margin="0,5,0,12" SelectionChanged="CmbExes_SelectionChanged"/><TextBlock x:Name="TxtEmuStatus" Text="● Emülatör: kontrol ediliyor" Foreground="#8fa2bc" FontSize="11"/></StackPanel>
                                <StackPanel Grid.Column="1">
                                    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="150"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LblPlayerName" Text="Oyuncu adı" Style="{StaticResource LabelStyle}"/><TextBox x:Name="TxtPlayerName" Text="Player1" Style="{StaticResource InputStyle}" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="LblAppId" Text="AppID" Style="{StaticResource LabelStyle}"/><TextBox x:Name="TxtAppId" Style="{StaticResource InputStyle}" Margin="0,5,0,0"/></StackPanel></Grid>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="LblFriendIp" Text="Arkadaş IP" Style="{StaticResource LabelStyle}"/><TextBox x:Name="TxtFriendIp" Style="{StaticResource InputStyle}" Margin="0,5,10,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="LblGameLang" Text="Oyun dili" Style="{StaticResource LabelStyle}"/><ComboBox x:Name="CmbLanguage" Background="#0a1220" Foreground="#dbe7f5" BorderBrush="#263b58" Margin="0,5,10,0"><ComboBoxItem Content="Türkçe" IsSelected="True"/><ComboBoxItem Content="English"/><ComboBoxItem Content="Deutsch"/></ComboBox></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Doğrulama" Style="{StaticResource LabelStyle}"/><TextBlock Text="Yerel kontroller kullanılır" Foreground="#4ade80" FontSize="11" Margin="0,8,0,0"/></StackPanel></Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0"><Button x:Name="BtnApply" Content="⚡ Onar / Uygula" Click="BtnApplyFix_Click" Style="{StaticResource PrimaryButton}" Margin="0,0,8,0"/><Button x:Name="BtnRestore" Content="↶ Yedekten Geri Yükle" Click="BtnRestore_Click" Style="{StaticResource SecondaryButton}"/></StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="BannerAutoSetup" Background="#3a2411" BorderBrush="#7a4a16" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,12" Visibility="Collapsed"><Grid><TextBlock x:Name="BannerText" Text="⚠ Radmin VPN bulunamadı." Foreground="#fbbf24" VerticalAlignment="Center"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="BtnDownloadRadmin" Content="Resmi site" Click="BtnDownloadRadmin_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/><Button x:Name="BtnAutoSetupBanner" Content="Standart ayar" Click="BtnAutoSetup_Click" Style="{StaticResource PrimaryButton}"/></StackPanel></Grid></Border>
                        <Border x:Name="ProgressArea" Style="{StaticResource CardStyle}" Padding="12" Visibility="Collapsed"><ProgressBar x:Name="ProgressBar" Height="8" Minimum="0" Maximum="100" Foreground="#3b82f6" Background="#09111d"/><TextBlock x:Name="TxtProgress" Text="Hazırlanıyor..." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,6,0,0"/></Border>
                    </StackPanel>

                    <!-- ROOM -->
                    <StackPanel x:Name="SectionFriends" Visibility="Collapsed">
                        <TextBlock Text="Oyun Odası" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Radmin üzerinden görülebilen ağ durumları." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Oyuncu" Foreground="{StaticResource Muted}"/><TextBlock Text="Durum" Grid.Column="1" Foreground="{StaticResource Muted}"/><TextBlock Text="Ping" Grid.Column="2" Foreground="{StaticResource Muted}"/><TextBlock Text="IP" Grid.Column="3" Foreground="{StaticResource Muted}"/></Grid>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Revan (Sen) · Host" Foreground="{StaticResource Text}"/><TextBlock Text="● Bağlı" Grid.Column="1" Foreground="#4ade80"/><TextBlock Text="18 ms" Grid.Column="2" Foreground="#67e8f9"/><TextBlock Text="26.12.45.7" Grid.Column="3" Foreground="{StaticResource Muted}"/><TextBlock Text="…" Grid.Column="4" Foreground="{StaticResource Muted}"/></Grid>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Ali" Foreground="{StaticResource Text}"/><TextBlock Text="● Bağlı" Grid.Column="1" Foreground="#4ade80"/><TextBlock Text="21 ms" Grid.Column="2" Foreground="#67e8f9"/><TextBlock Text="26.12.45.8" Grid.Column="3" Foreground="{StaticResource Muted}"/><TextBlock Text="…" Grid.Column="4" Foreground="{StaticResource Muted}"/></Grid>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Emre" Foreground="{StaticResource Text}"/><TextBlock Text="● Bağlı" Grid.Column="1" Foreground="#4ade80"/><TextBlock Text="24 ms" Grid.Column="2" Foreground="#67e8f9"/><TextBlock Text="26.12.45.12" Grid.Column="3" Foreground="{StaticResource Muted}"/><TextBlock Text="…" Grid.Column="4" Foreground="{StaticResource Muted}"/></Grid>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Deniz" Foreground="{StaticResource Text}"/><TextBlock Text="● Bağlı" Grid.Column="1" Foreground="#f59e0b"/><TextBlock Text="82 ms" Grid.Column="2" Foreground="#f59e0b"/><TextBlock Text="26.12.45.15" Grid.Column="3" Foreground="{StaticResource Muted}"/><TextBlock Text="…" Grid.Column="4" Foreground="{StaticResource Muted}"/></Grid>
                                <Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/><ColumnDefinition Width="100"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Mert" Foreground="{StaticResource Text}"/><TextBlock Text="● Çevrimdışı" Grid.Column="1" Foreground="#8291a5"/><TextBlock Text="—" Grid.Column="2" Foreground="#8291a5"/><TextBlock Text="—" Grid.Column="3" Foreground="#8291a5"/><TextBlock Text="…" Grid.Column="4" Foreground="{StaticResource Muted}"/></Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0"><TextBox x:Name="TxtFriendName" Style="{StaticResource InputStyle}" Width="160" Margin="0,0,7,0"/><TextBox x:Name="TxtNewFriendIp" Style="{StaticResource InputStyle}" Width="160" Margin="0,0,7,0"/><Button x:Name="BtnAddFriend" Content="+ Ekle" Click="BtnAddFriend_Click" Style="{StaticResource PrimaryButton}"/></StackPanel>
                                <Grid Margin="0,10,0,0"><ListBox x:Name="LstFriends" Height="1" Opacity="0" SelectionChanged="LstFriends_SelectionChanged" MouseDoubleClick="LstFriends_DoubleClick"/><Button x:Name="BtnUseFriend" Content="Kullan" Click="BtnUseFriend_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0"/><Button x:Name="BtnRemoveFriend" Content="Sil" Click="BtnRemoveFriend_Click" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Margin="70,0,0,0"/></Grid>
                                <TextBlock x:Name="LblFriends" Text="Ağ bağlantısı gerçek zamanlı kontrol edilir; oyun lobisi hazır bilgisi bu sürümde gösterilmez." Foreground="{StaticResource Muted}" FontSize="10" Margin="0,12,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- NETWORK -->
                    <StackPanel x:Name="SectionNetwork" Visibility="Collapsed">
                        <TextBlock Text="Ağ" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Radmin VPN ve bağlantı kalitesinin teknik görünümü." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
                        <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,0"><StackPanel><TextBlock Text="Radmin VPN" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock x:Name="TxtNetworkRadminStatus" Text="● Bağlı" Foreground="#4ade80" FontSize="12" Margin="0,8,0,12"/><TextBlock Text="IP adresi: otomatik algılanır" Foreground="{StaticResource Muted}" FontSize="10"/><TextBlock Text="Adaptör: Radmin VPN" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Grid.Column="1" Margin="8,0"><StackPanel><TextBlock Text="Ping" Style="{StaticResource LabelStyle}"/><TextBlock x:Name="TxtNetworkPingStatus" Text="18 ms" FontSize="25" Foreground="#67e8f9" FontWeight="SemiBold" Margin="0,4,0,0"/><TextBlock Text="Kayıp 0%  ·  Jitter 2 ms" Foreground="#8fa2bc" FontSize="10" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Grid.Column="2" Margin="8,0,0,0"><StackPanel><TextBlock Text="Tanılama" Style="{StaticResource LabelStyle}"/><Button Content="Ping testi" Style="{StaticResource PrimaryButton}" Margin="0,10,0,0"/><Button Content="Bağlantı taraması" Style="{StaticResource SecondaryButton}" Margin="0,7,0,0"/></StackPanel></Border>
                        </Grid>
                        <Border Style="{StaticResource CardStyle}"><StackPanel><TextBlock Text="Bağlantı kalitesi" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><Border Background="#0a1422" Height="130" Margin="0,12,0,0" CornerRadius="8"><TextBlock Text="          ───╲____╱───╲________╱────╲___" Foreground="#22d3ee" FontSize="16" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></StackPanel></Border>
                    </StackPanel>

                    <!-- TOOLS -->
                    <StackPanel x:Name="SectionTools" Visibility="Collapsed">
                        <TextBlock Text="Araçlar" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Teknik işlemler ana ekrandan ayrı tutulur." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
                        <UniformGrid Columns="3" Margin="0,0,0,14">
                            <Border Style="{StaticResource CardStyle}" Margin="0,0,8,8"><StackPanel><TextBlock Text="Emülatör" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Goldberg yönetimi" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12"/><Button Content="Aç" Click="BtnFindEmulator_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="8,0,8,8"><StackPanel><TextBlock Text="Onarım" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Eksik dosyaları onar" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12"/><Button Content="Onarım ekranı" Click="Nav_Click" Tag="game" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
                            <Border Style="{StaticResource CardStyle}" Margin="8,0,0,8"><StackPanel><TextBlock Text="Yedekleme" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Oyun ayarlarını yedekle" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,4,0,12"/><Button Content="Geri yükleme" Click="BtnRestore_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></Border>
                        </UniformGrid>
                        <Border Style="{StaticResource CardStyle}"><TextBlock Text="Sistem kontrolü  ·  Firewall  ·  Başlangıç seçenekleri  ·  Oyun ayarları" Foreground="{StaticResource Muted}" FontSize="11"/></Border>
                    </StackPanel>

                    <!-- SETTINGS -->
                    <StackPanel x:Name="SectionSettings" Visibility="Collapsed">
                        <TextBlock Text="Ayarlar" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/>
                        <TextBlock Text="Uygulama, oyun, ağ ve görünüm tercihleri." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,14"/>
                        <Border Style="{StaticResource CardStyle}"><StackPanel>
                            <TextBlock Text="Genel" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Text}" Margin="0,0,0,12"/>
                            <CheckBox x:Name="ChkUnlockDlc" Content="DLC.txt şablonu oluştur" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkFirewall" Content="Güvenlik Duvarı İzni" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
                            <CheckBox x:Name="ChkCustomBroadcast" Content="Radmin Lobi Sabitleme" Foreground="{StaticResource Text}" Margin="0,0,0,16"/>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="LblTheme" Text="Tema" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="CmbTheme" Grid.Column="1" Background="#0a1220" Foreground="#dbe7f5" BorderBrush="#263b58" SelectionChanged="CmbTheme_SelectionChanged"><ComboBoxItem x:Name="BtnThemeGece" Content="Gece" IsSelected="True" Tag="gece"/><ComboBoxItem x:Name="BtnThemeGunduz" Content="Gündüz" Tag="gunduz"/><ComboBoxItem x:Name="BtnThemePembe" Content="Pembe" Tag="pembe"/></ComboBox></Grid>
                            <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="180"/></Grid.ColumnDefinitions><TextBlock x:Name="LblUiLang" Text="Arayüz dili" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/><ComboBox x:Name="CmbUiLang" Grid.Column="1" Background="#0a1220" Foreground="#dbe7f5" BorderBrush="#263b58" SelectionChanged="CmbUiLang_SelectionChanged"><ComboBoxItem x:Name="BtnUiTr" Content="Türkçe" IsSelected="True" Tag="tr"/><ComboBoxItem x:Name="BtnUiEn" Content="English" Tag="en"/><ComboBoxItem x:Name="BtnUiDe" Content="Deutsch" Tag="de"/></ComboBox></Grid>
                            <CheckBox x:Name="ChkMascot" Content="Mavi maskotunu göster" IsChecked="True" Foreground="{StaticResource Text}" Click="ChkMascot_Click"/>
                        </StackPanel></Border>
                    </StackPanel>

                    <!-- LOG -->
                    <StackPanel x:Name="SectionLog" Visibility="Collapsed">
                        <DockPanel Margin="0,0,0,14"><StackPanel><TextBlock Text="Loglar" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Text}"/><TextBlock Text="Teknik olayları burada inceleyin." Foreground="{StaticResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><StackPanel Orientation="Horizontal" DockPanel.Dock="Right"><Button x:Name="BtnCopyLog" Content="Kopyala" Click="BtnCopyLog_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/><Button x:Name="BtnExportLog" Content="Dışa Aktar" Click="BtnExportLog_Click" Style="{StaticResource SecondaryButton}" Margin="0,0,7,0"/><Button x:Name="BtnClearLog" Content="Temizle" Click="BtnClearLog_Click" Style="{StaticResource SecondaryButton}"/></StackPanel></DockPanel>
                        <Border Style="{StaticResource CardStyle}" Padding="0"><TextBox x:Name="TxtLog" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#08111d" Foreground="#78e6a0" FontFamily="Consolas" FontSize="11" Padding="12" Height="500" BorderThickness="0"/></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
