<Window x:Class="SteamLANControlCenter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam LAN Control Center v2.1" 
        Height="780" Width="680"
        MinWidth="500" MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        Background="#181825" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Segoe UI Variable, Arial"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Başlık -->
        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="🎮 STEAM LAN CONTROL CENTER" FontSize="20" FontWeight="Bold" Foreground="#f5e0dc" HorizontalAlignment="Center"/>
            <TextBlock Text="Gelişmiş Goldberg LAN &amp; Radmin VPN Otomasyon Paneli" FontSize="12" Foreground="#a6adc8" HorizontalAlignment="Center" Margin="0,3,0,0"/>
        </StackPanel>

        <!-- Akıllı Otomatik Kurulum Bildirim Baneri -->
        <Border x:Name="BannerAutoSetup" Grid.Row="1" Background="#f38ba8" CornerRadius="6" Padding="10" Margin="0,0,0,10" Visibility="Collapsed">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="⚠️ Sistemde Radmin VPN veya gerekli bileşenler eksik!" Foreground="#11111b" FontWeight="Bold" VerticalAlignment="Center" FontSize="12"/>
                <Button Grid.Column="1" Content="⚡ Hızlı Otomatik Kur" Click="BtnAutoSetup_Click" Background="#11111b" Foreground="#ffffff" FontWeight="Bold" Padding="8,4" Cursor="Hand"/>
            </Grid>
        </Border>

        <!-- Canlı Durum Kartı -->
        <Border Grid.Row="2" Background="#1e1e2e" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="TxtRadminStatus" Text="🔴 Radmin VPN: Kontrol Ediliyor..." FontSize="13" FontWeight="SemiBold" Foreground="#f38ba8"/>
                <TextBlock x:Name="TxtPingStatus" Grid.Column="1" Text="Ping: -- ms" FontSize="13" Foreground="#a6adc8"/>
                <TextBlock x:Name="TxtPatchStatus" Grid.Row="1" Text="🔴 Oyun Durumu: Klasör Seçilmedi" FontSize="13" FontWeight="SemiBold" Foreground="#f38ba8" Margin="0,6,0,0" Grid.ColumnSpan="2"/>
            </Grid>
        </Border>

        <!-- Ayarlar ve Girdiler -->
        <Border Grid.Row="3" Background="#1e1e2e" CornerRadius="8" Padding="12" Margin="0,0,0,10" BorderBrush="#313244" BorderThickness="1">
            <StackPanel>
                <!-- Oyun Klasör Seçimi -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="40"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Oyun Klasörü:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="TxtGamePath" IsReadOnly="True" Background="#11111b" Foreground="#a6adc8" BorderBrush="#45475a" Padding="6" FontSize="12" Grid.Column="1"/>
                    <Button Grid.Column="2" Content="..." Click="BtnBrowse_Click" Background="#45475a" Foreground="#cdd6f4" Margin="5,0,0,0" FontSize="13" FontWeight="Bold" Cursor="Hand"/>
                </Grid>

                <!-- Oyuncu İsmi & AppID -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="90"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Oyuncu Adı:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="TxtPlayerName" Grid.Column="1" Text="Player1" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="6" FontSize="13" Margin="0,0,8,0"/>

                    <TextBlock Text="AppID:" Grid.Column="2" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="TxtAppId" Grid.Column="3" Text="480" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="6" FontSize="13"/>
                </Grid>

                <!-- Arkadaş Radmin IP & Oyun Dili -->
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="45"/>
                        <ColumnDefinition Width="100"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Arkadaş IP:" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="13"/>
                    <TextBox x:Name="TxtFriendIp" Grid.Column="1" Text="26.x.x.x" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" Padding="6" FontSize="12" Margin="0,0,8,0" TextChanged="TxtFriendIp_TextChanged"/>

                    <TextBlock Text="Dil:" Grid.Column="2" Foreground="#cdd6f4" VerticalAlignment="Center" FontSize="13"/>
                    <ComboBox x:Name="CmbLanguage" Grid.Column="3" Background="#11111b" Foreground="#11111b" BorderBrush="#45475a" FontSize="12" Padding="4">
                        <ComboBoxItem Content="english" IsSelected="True"/>
                        <ComboBoxItem Content="turkish"/>
                        <ComboBoxItem Content="german"/>
                        <ComboBoxItem Content="french"/>
                        <ComboBoxItem Content="russian"/>
                    </ComboBox>
                </Grid>

                <!-- Onay Kutuları -->
                <WrapPanel Margin="0,4,0,0">
                    <CheckBox x:Name="ChkUnlockDlc" Content="Tüm DLC'leri Aç" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,12,5"/>
                    <CheckBox x:Name="ChkFirewall" Content="Güvenlik Duvarı İzni" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,12,5"/>
                    <CheckBox x:Name="ChkCustomBroadcast" Content="Radmin Lobi Sabitleme" IsChecked="True" Foreground="#cdd6f4" FontSize="12" Margin="0,0,0,5"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- İşlem Butonları -->
        <Grid Grid.Row="4" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="1.2*"/>
            </Grid.ColumnDefinitions>
            <Button Content="⚡ Goldberg Fix Uygula" Click="BtnApplyFix_Click" Background="#a6e3a1" Foreground="#11111b" FontWeight="Bold" FontSize="13" Padding="10" Margin="0,0,4,0" Cursor="Hand"/>
            <Button Content="🔄 Geri Yükle" Click="BtnRestore_Click" Background="#f9e2af" Foreground="#11111b" FontWeight="Bold" FontSize="13" Padding="10" Grid.Column="1" Margin="2,0,2,0" Cursor="Hand"/>
            <Button x:Name="BtnLaunch" Content="🚀 Oyunu Başlat" Click="BtnLaunch_Click" IsEnabled="False" Background="#89b4fa" Foreground="#11111b" FontWeight="Bold" FontSize="13" Padding="10" Grid.Column="2" Margin="4,0,0,0" Cursor="Hand"/>
        </Grid>

        <!-- Bilgi Konsolu -->
        <TextBox x:Name="TxtLog" Grid.Row="5" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Background="#11111b" Foreground="#a6e3a1" FontFamily="Consolas, Courier New" FontSize="12" Padding="8" BorderBrush="#313244"/>
    </Grid>
</Window>
