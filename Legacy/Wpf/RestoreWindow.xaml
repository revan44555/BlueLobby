<Window x:Class="BlueLobby.RestoreWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Geri Almayı Onayla" Height="520" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip"
        Background="#181825"
        FontFamily="Segoe UI, Arial">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="TxtHeading" FontSize="16" FontWeight="Bold" Foreground="#f5e0dc" TextWrapping="Wrap"/>
        <TextBlock x:Name="TxtDate" Grid.Row="1" Margin="0,6,0,10" Foreground="#a6adc8" FontSize="12" TextWrapping="Wrap"/>

        <ListBox x:Name="LstItems" Grid.Row="2" Background="#11111b" Foreground="#cdd6f4" BorderBrush="#45475a" FontSize="12" Padding="6">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="2">
                        <TextBlock Text="{Binding Icon}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Vazgeç" IsCancel="True" Background="#45475a" Foreground="#cdd6f4" Padding="14,6" Margin="0,0,8,0" Cursor="Hand"/>
            <Button Content="✔ Geri Al" IsDefault="True" Click="BtnConfirm_Click" Background="#a6e3a1" Foreground="#11111b" FontWeight="Bold" Padding="14,6" Cursor="Hand"/>
        </StackPanel>
    </Grid>
</Window>
